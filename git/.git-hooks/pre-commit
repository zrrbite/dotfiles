#!/bin/bash
#
# Pre-commit hook - handles both C++ and TypeScript/JavaScript projects
# For C++: Checks formatting with clang-format
# For TS/JS: Delegates to pre-commit-ts

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Block commits containing the do-not-commit marker (any file type).
# TOKEN is split so this hook file never contains the literal marker —
# otherwise committing the hook itself would trip the check.
# The trailing 'grep -q .' guards the empty-staged-list case: with no
# input files, macOS xargs exits 0 without running grep, which would
# otherwise read as a match and block message-only amends.
TOKEN='!no''commit'
if git diff --cached --name-only -z --diff-filter=ACMR |
        xargs -0 grep -l -- "$TOKEN" 2>/dev/null | grep -q .; then
    echo -e "${RED}Error: Found '$TOKEN' in staged files. Remove it before committing.${NC}"
    exit 1
fi

# Check for TypeScript/JavaScript files first
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$')
if [ -n "$STAGED_TS_FILES" ] && [ -f "package.json" ]; then
    # This is a TypeScript/JavaScript project, delegate to pre-commit-ts
    HOOK_DIR="$(git config --get core.hooksPath || echo ~/.git-hooks)"
    if [ -f "$HOOK_DIR/pre-commit-ts" ]; then
        exec "$HOOK_DIR/pre-commit-ts"
    fi
fi

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h|cc|cxx|c)$')

if [ -z "$STAGED_FILES" ]; then
    # No C++ files staged, skip check
    exit 0
fi

# Pin the formatter rather than trusting whatever PATH resolves to.
#
# Two clang-formats are commonly installed side by side here: the llvm
# formula (/opt/homebrew/opt/llvm/bin/clang-format, currently 21) and the
# clang-format formula (/opt/homebrew/bin/clang-format, currently 15). They
# agree on almost everything -- but not everything: LLVM 16+ puts a lambda's
# opening brace on its own line where 15 keeps it on the same line. Whichever
# comes first on PATH wins, so an unpinned hook silently reformats files back
# and forth depending on which shell ran it, and blames the author.
#
# Override per machine with:  git config --global clangFormat.binary <path>
CF="$(git config --get clangFormat.binary)"
if [ -z "$CF" ]; then
    for candidate in /opt/homebrew/opt/llvm/bin/clang-format \
                     /usr/local/opt/llvm/bin/clang-format \
                     "$(command -v clang-format 2>/dev/null)"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            CF="$candidate"
            break
        fi
    done
fi

if [ -z "$CF" ]; then
    echo -e "${RED}Error: no clang-format found. Install one, or set:${NC}"
    echo -e "${RED}       git config --global clangFormat.binary <path>${NC}"
    exit 1
fi

CF_VERSION="$("$CF" --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"

# Name the version in the output. When two machines format the same file
# differently, this line is what makes the cause obvious rather than
# mysterious.
echo "Checking C++ code formatting (clang-format $CF_VERSION)..."

# A repository's first commit has no HEAD, and `git clang-format --staged`
# diffs against HEAD: it prints "fatal: bad revision 'HEAD'" and checks
# nothing. It won't take the empty tree instead (it wants a commit). Every line
# of a first commit is new anyway, so format each staged file whole and diff it
# against itself. Output mimics git clang-format's, so the handling below is
# shared. Style comes from the nearest .clang-format, as with git clang-format.
first_commit_diff() {
    local f d out=""
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if ! d="$(diff -u --label "a/$f" --label "b/$f" \
                <(git show ":$f") <(git show ":$f" | "$CF" --assume-filename="$f"))"; then
            out+="diff --git a/$f b/$f"$'\n'"$d"$'\n'
        fi
    done <<< "$STAGED_FILES"
    [ -n "$out" ] && printf '%s' "$out" || echo "clang-format did not modify any files"
}

# --diff mode shows what would change. stderr is kept, so an error lands in
# OUTPUT and fails the check below instead of reading as "all formatted".
if git rev-parse --verify --quiet HEAD >/dev/null; then
    OUTPUT=$(git clang-format --binary "$CF" --staged --diff 2>&1)
else
    OUTPUT=$(first_commit_diff 2>&1)
fi

# Check if there are formatting issues
if echo "$OUTPUT" | grep -q "no modified files to format" || echo "$OUTPUT" | grep -q "clang-format did not modify any files"; then
    echo -e "${GREEN}✓ All staged C++ files are properly formatted${NC}"
    exit 0
elif echo "$OUTPUT" | grep -q "diff --git"; then
    echo ""
    echo -e "${RED}"
    cat << 'EOF'
    ╔═══════════════════════════════════════════════════════════════╗
    ║                                                               ║
    ║   ⚠️  FORMATTING VIOLATION DETECTED!  ⚠️                      ║
    ║                                                               ║
    ║        (╯°□°)╯︵ ┻━┻                                         ║
    ║                                                               ║
    ║   Your code needs some love! clang-format says:              ║
    ║   "This code could be prettier..."                           ║
    ║                                                               ║
    ╚═══════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
    echo ""
    echo -e "${YELLOW}The following formatting changes are needed:${NC}"
    echo "$OUTPUT"
    echo ""
    echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║  How to fix:                                               ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}  1. Auto-format staged files:${NC}"
    echo -e "     ${GREEN}git cf${NC}              ${YELLOW}# Formats all staged C++ files${NC}"
    echo -e "     ${GREEN}git commit${NC}          ${YELLOW}# Try committing again${NC}"
    echo ""
    echo -e "${YELLOW}  2. Alternative (manual):${NC}"
    echo -e "     ${GREEN}git clang-format --staged${NC}"
    echo -e "     ${GREEN}git add -u${NC}"
    echo -e "     ${GREEN}git commit${NC}"
    echo ""
    echo -e "${YELLOW}  3. Bypass hook (not recommended):${NC}"
    echo -e "     ${GREEN}git commit --no-verify${NC}"
    echo ""
    echo -e "${RED}┻━┻ ︵ヽ(\`Д´)ﾉ︵ ┻━┻  Please format your code!${NC}"
    echo ""
    exit 1
else
    # Neither "nothing to format" nor a diff: something went wrong. Before,
    # this branch passed -- which is how a first commit's
    # "fatal: bad revision 'HEAD'" was reported as "properly formatted".
    echo -e "${RED}Error: could not check formatting:${NC}"
    echo "$OUTPUT"
    echo -e "${YELLOW}Bypass once if you must: git commit --no-verify${NC}"
    exit 1
fi
