#!/bin/bash
#
# Pre-commit hook - handles both C++ and TypeScript/JavaScript projects
# For C++: Checks formatting with clang-format
# For TS/JS: Delegates to pre-commit-ts

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Block commits containing the do-not-commit marker (any file type).
# TOKEN is split so this hook file never contains the literal marker —
# otherwise committing the hook itself would trip the check.
# The trailing 'grep -q .' guards the empty-staged-list case: with no
# input files, macOS xargs exits 0 without running grep, which would
# otherwise read as a match and block message-only amends.
TOKEN='!no''commit'
if git diff --cached --name-only -z --diff-filter=ACMR |
        xargs -0 grep -l -- "$TOKEN" 2>/dev/null | grep -q .; then
    echo -e "${RED}Error: Found '$TOKEN' in staged files. Remove it before committing.${NC}"
    exit 1
fi

# Check for TypeScript/JavaScript files first
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$')
if [ -n "$STAGED_TS_FILES" ] && [ -f "package.json" ]; then
    # This is a TypeScript/JavaScript project, delegate to pre-commit-ts
    HOOK_DIR="$(git config --get core.hooksPath || echo ~/.git-hooks)"
    if [ -f "$HOOK_DIR/pre-commit-ts" ]; then
        exec "$HOOK_DIR/pre-commit-ts"
    fi
fi

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h|cc|cxx|c)$')

if [ -z "$STAGED_FILES" ]; then
    # No C++ files staged, skip check
    exit 0
fi

echo "Checking C++ code formatting..."

# Run git-clang-format to check if staged changes are formatted
# --diff mode shows what would change, returns non-zero if formatting needed
OUTPUT=$(git clang-format --staged --diff)

# Check if there are formatting issues
if echo "$OUTPUT" | grep -q "no modified files to format" || echo "$OUTPUT" | grep -q "clang-format did not modify any files"; then
    echo -e "${GREEN}✓ All staged C++ files are properly formatted${NC}"
    exit 0
elif echo "$OUTPUT" | grep -q "diff --git"; then
    echo ""
    echo -e "${RED}"
    cat << 'EOF'
    ╔═══════════════════════════════════════════════════════════════╗
    ║                                                               ║
    ║   ⚠️  FORMATTING VIOLATION DETECTED!  ⚠️                      ║
    ║                                                               ║
    ║        (╯°□°)╯︵ ┻━┻                                         ║
    ║                                                               ║
    ║   Your code needs some love! clang-format says:              ║
    ║   "This code could be prettier..."                           ║
    ║                                                               ║
    ╚═══════════════════════════════════════════════════════════════╝
EOF
    echo -e "${NC}"
    echo ""
    echo -e "${YELLOW}The following formatting changes are needed:${NC}"
    echo "$OUTPUT"
    echo ""
    echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║  How to fix:                                               ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YELLOW}  1. Auto-format staged files:${NC}"
    echo -e "     ${GREEN}git cf${NC}              ${YELLOW}# Formats all staged C++ files${NC}"
    echo -e "     ${GREEN}git commit${NC}          ${YELLOW}# Try committing again${NC}"
    echo ""
    echo -e "${YELLOW}  2. Alternative (manual):${NC}"
    echo -e "     ${GREEN}git clang-format --staged${NC}"
    echo -e "     ${GREEN}git add -u${NC}"
    echo -e "     ${GREEN}git commit${NC}"
    echo ""
    echo -e "${YELLOW}  3. Bypass hook (not recommended):${NC}"
    echo -e "     ${GREEN}git commit --no-verify${NC}"
    echo ""
    echo -e "${RED}┻━┻ ︵ヽ(\`Д´)ﾉ︵ ┻━┻  Please format your code!${NC}"
    echo ""
    exit 1
else
    # No differences detected or other case
    echo -e "${GREEN}✓ All staged C++ files are properly formatted${NC}"
    exit 0
fi
