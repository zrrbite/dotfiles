#!/bin/bash

# Nord palette. Kept complete rather than trimmed to what is currently
# referenced, so restyling means picking a name instead of looking up a hex.
# shellcheck disable=SC2034
NORD0=0xff2e3440
NORD1=0xff3b4252
NORD2=0xff434c5e
NORD3=0xff4c566a
NORD4=0xffd8dee9
NORD6=0xffeceff4
NORD7=0xff8fbcbb
NORD8=0xff88c0d0
NORD9=0xff81a1c1
NORD10=0xff5e81ac
NORD11=0xffbf616a
NORD13=0xffebcb8b
NORD14=0xffa3be8c
NORD15=0xffb48ead

# Bar background at 90% opacity, matching waybar's rgba(46, 52, 64, 0.9)
BAR_BG=0xe62e3440

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Bar appearance
# Pinned edge-to-edge at the top. aerospace.toml's gaps.outer.top = 44 is this
# 32pt height plus a 12pt gap -- change the height and that gap must follow.
sketchybar --bar \
    position=top \
    height=32 \
    blur_radius=30 \
    color=$BAR_BG \
    border_color=$NORD3 \
    border_width=2 \
    shadow=off \
    padding_left=12 \
    padding_right=12 \
    margin=0 \
    y_offset=0 \
    corner_radius=0 \
    topmost=window

# Defaults
# Interior padding mirrors waybar's `padding: 0 10px` on each module:
# 8px outside the icon, 4px between icon and label, 8px after the label.
# Item padding of 2 either side yields waybar's 4px inter-module spacing.
sketchybar --default \
    icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
    icon.color=$NORD0 \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label.font="JetBrainsMono Nerd Font:Bold:13.0" \
    label.color=$NORD0 \
    label.padding_left=0 \
    label.padding_right=8 \
    padding_left=2 \
    padding_right=2 \
    background.corner_radius=4 \
    background.height=26 \
    background.drawing=on

# -- AeroSpace workspaces (left) --
# Number as the icon, the apps on that workspace as the label, drawn with
# sketchybar-app-font. All styling that changes with state (focus, icons,
# hidden when empty) is set by plugins/spaces.sh, which drives every item from
# the one hidden `spaces` item below.
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item "space.$sid" left \
        --set "space.$sid" \
            icon="$sid" \
            icon.color=$NORD4 \
            icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
            icon.padding_left=8 \
            icon.padding_right=8 \
            label.color=$NORD4 \
            label.font="sketchybar-app-font:Regular:14.0" \
            label.padding_left=0 \
            label.padding_right=8 \
            label.y_offset=-1 \
            background.color=0x005e81ac \
            background.drawing=on \
            click_script="aerospace workspace $sid"
done

# Opening, closing or moving a window changes the icons without changing the
# workspace, so front_app_switched matters as much as the workspace event.
sketchybar --add item spaces left \
    --set spaces \
        drawing=off \
        updates=on \
        script="$PLUGIN_DIR/spaces.sh" \
    --subscribe spaces aerospace_workspace_change front_app_switched \
        space_windows_change system_woke

# -- Front app name (center-left) --
# Unfilled bold label, like waybar's #window, led by the app's icon from the
# same sketchybar-app-font as the workspace pills.
sketchybar --add item front_app left \
    --set front_app \
        icon.font="sketchybar-app-font:Regular:14.0" \
        icon.color=$NORD6 \
        icon.padding_left=8 \
        icon.padding_right=6 \
        icon.y_offset=-1 \
        background.drawing=off \
        label.color=$NORD6 \
        label.font="JetBrainsMono Nerd Font:Bold:13.0" \
        label.padding_left=0 \
        label.padding_right=8 \
        script="$PLUGIN_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

# -- Clock (right) --
sketchybar --add item clock right \
    --set clock \
        update_freq=30 \
        icon="" \
        background.color=$NORD10 \
        script="$PLUGIN_DIR/clock.sh"

# -- Battery (right) --
# Fill colour is set by the plugin: green / yellow charging / red low
sketchybar --add item battery right \
    --set battery \
        update_freq=120 \
        background.color=$NORD14 \
        script="$PLUGIN_DIR/battery.sh"

# -- Volume (right) --
# Fill colour is set by the plugin: yellow / grey when muted
sketchybar --add item volume right \
    --set volume \
        update_freq=5 \
        background.color=$NORD13 \
        script="$PLUGIN_DIR/volume.sh"

# -- Network (right) --
# Fill colour is set by the plugin: blue / red when disconnected
sketchybar --add item network right \
    --set network \
        update_freq=10 \
        background.color=$NORD9 \
        script="$PLUGIN_DIR/network.sh"

# -- Memory (right) --
sketchybar --add item memory right \
    --set memory \
        update_freq=10 \
        icon="󰍛" \
        background.color=$NORD15 \
        script="$PLUGIN_DIR/memory.sh"

# -- CPU (right) --
# update_freq is 10 rather than 5: cpu.sh samples `top` twice a second apart,
# which costs ~1.7s wall and ~0.65s CPU per run. At 5s that is a third of wall
# time and a steady ~13% of one core spent measuring CPU usage.
sketchybar --add item cpu right \
    --set cpu \
        update_freq=10 \
        icon="󰻠" \
        background.color=$NORD14 \
        script="$PLUGIN_DIR/cpu.sh"

# Force initial update
sketchybar --update
