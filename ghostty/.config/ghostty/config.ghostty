# Ghostty -- Nord, mirroring alacritty/.config/alacritty/alacritty.toml so the
# two can run side by side while Ghostty is on trial. Same font, size, padding,
# opacity and colours; the differences are what Ghostty adds (ligatures, the
# Kitty image protocol, a native macOS window).
#
# Ghostty 1.3 reads $XDG_CONFIG_HOME/ghostty/config.ghostty, hence the name.
# Check after editing:  ghostty +validate-config
# Every option, with docs:  ghostty +show-config --default --docs

# -- Font --------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 15

# -- Window ------------------------------------------------------------------
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95

# No title bar or traffic lights -- they only waste space under a tiling WM --
# but unlike `window-decoration = none`, macOS keeps the frame and rounded
# corners. Same intent as Alacritty's "Buttonless". To drag a window, use
# option+click on its edge.
macos-titlebar-style = hidden

# Left unset on purpose: on the Danish layout Option types { } [ ] | @ $, and
# treating it as Alt would break that. AeroSpace's alt-bindings are global and
# never reach the terminal anyway.
# macos-option-as-alt =

# -- Cursor and selection ----------------------------------------------------
cursor-style = block
# Shell integration switches the cursor to a bar at the prompt by default;
# `no-cursor` keeps the block, as in Alacritty. ssh-env and ssh-terminfo make
# SSH to hosts without Ghostty's terminfo (the Pi, servers) work instead of
# complaining about an unknown TERM.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Alacritty's save_to_clipboard: selecting copies to the system clipboard.
copy-on-select = clipboard

# -- Nord colours ------------------------------------------------------------
# Spelled out rather than `theme = Nord`, so they match Alacritty exactly
# and do not shift if the bundled theme changes.
background = #2E3440
foreground = #D8DEE9
cursor-color = #D8DEE9
cursor-text = #2E3440
selection-background = #4C566A
selection-foreground = cell-foreground

palette = 0=#3B4252
palette = 1=#BF616A
palette = 2=#A3BE8C
palette = 3=#EBCB8B
palette = 4=#81A1C1
palette = 5=#B48EAD
palette = 6=#88C0D0
palette = 7=#E5E9F0
palette = 8=#4C566A
palette = 9=#BF616A
palette = 10=#A3BE8C
palette = 11=#EBCB8B
palette = 12=#81A1C1
palette = 13=#B48EAD
palette = 14=#8FBCBB
palette = 15=#ECEFF4

# -- Keys --------------------------------------------------------------------
# Alacritty's bindings, so muscle memory carries over. The macOS defaults
# (cmd+c, cmd+v, cmd+plus/minus/0) keep working alongside them.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+digit_0=reset_font_size
