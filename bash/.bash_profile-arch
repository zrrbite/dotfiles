#
# ~/.bash_profile
#

# Load .bashrc if it exists
[[ -f ~/.bashrc ]] && . ~/.bashrc

# Auto-start Hyprland on TTY1. start-hyprland (Hyprland 0.53+) is the
# supported launcher: it restarts Hyprland in safe mode after a crash, and
# running `Hyprland` directly shows a warning. Fall back for older versions.
if [ -z "$DISPLAY" ] && [ "$XDG_VTNR" = 1 ]; then
    if command -v start-hyprland >/dev/null 2>&1; then
        exec start-hyprland
    else
        exec Hyprland
    fi
fi
