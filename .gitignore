.claude/settings.local.json

# zsh completion caches (zsh writes these next to .zshrc under ZDOTDIR)
.zcompdump*

# yazi plugins are fetched from yazi/.config/yazi/package.toml by `ya pkg install`.
yazi/.config/yazi/plugins/
yazi/.config/yazi/flavors/

# Agent worktrees (git worktree checkouts made by Claude Code subagents).
# They are separate checkouts of this repo; never track them.
.claude/worktrees/

# Karabiner-Elements keeps dated copies of karabiner.json next to it. The
# whole ~/.config/karabiner folder links here (Karabiner replaces the file
# when it saves, which would break a link to the file alone).
karabiner/.config/karabiner/automatic_backups/
